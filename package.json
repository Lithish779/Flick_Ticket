{
  "name": "flick-ticket",
  "version": "1.0.0",
  "description": "FlickTicket - Enterprise Cinema Hall Ticket Booking System",
  "main": "server/server.js",
  "author": "Lithish Kumar",
  "scripts": {
    "start": "node server/server.js",
    "build": "cd server && npm install",
    "postinstall": "cd server && npm install",
