    "seed": "cd server && npm run seed",
    "test": "cd server && npm test"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.3.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
